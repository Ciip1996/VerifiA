# App Store Connect - TestFlight Auto-Deploy
# Generate API key at: https://appstoreconnect.apple.com/access/api
# 1. Create a new key with "Admin" role
# 2. Download the .p8 file and extract its contents (or reference its path)
# 3. Get the Issuer ID from the Integrations > API section

# Path to your App Store Connect API private key (.p8 file)
APPLE_API_KEY_PATH=

# Your API Issuer ID (from App Store Connect > Integrations > API)
APPLE_API_ISSUER_ID=

# Your App ID on App Store Connect (VerifiA is: 6781379059)
APPLE_APP_ID=6781379059
